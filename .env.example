# Pristine reference copy of .env — the .env file is tracked in git and works
# out of the box after a clone. Copy this file over .env to reset it.
#
# Both CLIs pick up the .env file automatically when run from this folder.
# To load it into your shell manually: set -a; source .env; set +a

# Credentials for the local workshop database (docker compose)
DATACONTRACT_POSTGRES_USERNAME=workshop
DATACONTRACT_POSTGRES_PASSWORD=workshop

# Entropy Data (Part D) - create an API key in your organization settings
ENTROPY_DATA_API_KEY=ed_...
ENTROPY_DATA_HOST=https://api.entropy-data.com

# Running Entropy Data (Community Edition) locally instead?
#   docker compose -f entropy-data-ce/docker-compose.yaml up -d
#   ./scripts/setup-entropy-data-ce.sh   # creates account, organization, and API key, and updates this file
#   (Windows: scripts\setup-entropy-data-ce.bat)
# Then use this host instead:
# ENTROPY_DATA_HOST=http://localhost:8081

# Credentials for the local Entropy Data (Community Edition) bootstrap
# (on the cloud, suffix your first name to avoid collisions, e.g. datameshlive2026-simon)
ENTROPY_DATA_CE_EMAIL=workshop@example.com
ENTROPY_DATA_CE_PASSWORD=workshop
ENTROPY_DATA_CE_ORGANIZATION=datameshlive2026

# AI assistant in the Data Contract Editor (datacontract edit)
DATACONTRACT_EDITOR_AI_PROVIDER=anthropic
DATACONTRACT_EDITOR_AI_ENDPOINT=https://entropy-data-ai-demo.services.ai.azure.com/anthropic/v1/messages
DATACONTRACT_EDITOR_AI_API_KEY=your-api-key
DATACONTRACT_EDITOR_AI_MODEL=claude-haiku-4-5
DATACONTRACT_EDITOR_AI_AUTH_HEADER=x-api-key
